# Dependencies are installed inside the image. Copying the local vendor/ in
# would overwrite that clean install with one built on a different OS.
vendor/
node_modules/

# Secrets must come from the platform's environment, never from a file baked
# into the image — an image layer is readable by anyone who can pull it.
.env
.env.*
!.env.example

# Local-only artefacts.
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*
.phpunit.result.cache
.phpunit.cache/

# Not needed at runtime.
tests/
.git/
.gitignore
.gitattributes
README.md
