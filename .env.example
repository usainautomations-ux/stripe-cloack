# Application
NEXT_PUBLIC_APP_URL=https://payments.example.com
NODE_ENV=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/stripe_gateway_hub

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Auth (NextAuth)
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars
NEXTAUTH_URL=https://payments.example.com

# Admin credentials (for initial setup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-immediately

# Redis (optional, for rate limiting & caching)
REDIS_URL=redis://localhost:6379

# API Key salt (used for hashing tenant API keys)
API_KEY_SECRET=your-api-key-signing-secret-32-chars-min

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
